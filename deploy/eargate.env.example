# ─── Яндекс ───
YANDEX_SKILL_ID=ваш-skill-id-из-dialogs.yandex.ru
YANDEX_OAUTH_TOKEN=ваш-oauth-токен

# ─── Аудио ───
# microphone | rtsp
AUDIO_SOURCE=microphone
MIC_ENTRY_DEVICE_INDEX=0
MIC_EXIT_DEVICE_INDEX=1

# Если AUDIO_SOURCE=rtsp:
# RTSP_AUDIO_URL_ENTRY=rtsp://admin:pass@192.168.1.50:554/stream1
# RTSP_AUDIO_URL_EXIT=rtsp://admin:pass@192.168.1.51:554/stream1

# ─── Вебхук ───
WEBHOOK_PORT=8080
